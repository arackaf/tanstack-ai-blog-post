{
  "name": "tanstack-ai-blog-post",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "format": "npx prettier --write \"src/**/*.{ts,tsx}\"",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "update-tanstack-ai": "npm i @tanstack/ai@latest && npm i @tanstack/ai-persistence@latest && npm i @tanstack/ai-react@latest && npm i @tanstack/ai-vercel-gateway@latest",
    "pg": "docker container run -e POSTGRES_USER=docker -e POSTGRES_PASSWORD=docker -p 5432:5432 -v ~/Documents/pg-tanstack-ai-post:/var/lib/postgresql postgres:18.2-alpine3.23"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/ai": "^0.64.1",
    "@tanstack/ai-persistence": "^0.7.2",
    "@tanstack/ai-react": "^0.29.4",
    "@tanstack/ai-vercel-gateway": "^0.3.3",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@types/pg": "^8.23.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "drizzle-orm": "^1.0.0-rc.4",
    "effect": "^4.0.0-beta.107",
    "lucide-react": "^1.48.0",
    "nitro": "3.0.260610-beta",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
